# Copie para .env.local e preencha.

# Endereço final do site (usado no SEO, sitemap e links de compartilhamento)
NEXT_PUBLIC_SITE_URL=https://namesa.com.br

# WhatsApp de vendas: só números, com 55 + DDD. Ex.: 5585999999999
# Vazio = o botão flutuante e o link de WhatsApp não aparecem.
NEXT_PUBLIC_WHATSAPP=

# E-mail de contato mostrado na página e nos termos
NEXT_PUBLIC_EMAIL=

# Envio do formulário por e-mail (https://resend.com). Opcional:
# sem isso, o formulário abre o WhatsApp com a mensagem já preenchida.
RESEND_API_KEY=
EMAIL_FROM=NaMesa <contato@seudominio.com.br>
CONTATO_EMAIL_PARA=
